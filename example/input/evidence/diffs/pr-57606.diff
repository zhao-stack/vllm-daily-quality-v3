diff --git a/docker/Dockerfile b/docker/Dockerfile
index ad010285b181..a0f1187e75eb 100644
--- a/docker/Dockerfile
+++ b/docker/Dockerfile
@@ -1047,6 +1047,10 @@ RUN --mount=type=bind,from=build,src=/workspace/dist,target=/vllm-workspace/dist
         --extra-index-url ${PYTORCH_CUDA_INDEX_BASE_URL}/cu$(echo $CUDA_VERSION | cut -d. -f1,2 | tr -d '.'); \
