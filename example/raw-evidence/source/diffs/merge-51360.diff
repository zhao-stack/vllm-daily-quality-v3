+def _validation_path(error: ValidationError) -> str:
+    detail = error.errors(include_url=False)[0]
+    location = detail["loc"]
+    if not location:
+        return "JSON" if detail["type"] == "json_invalid" else "root"
+    return ".".join(map(str, location))
