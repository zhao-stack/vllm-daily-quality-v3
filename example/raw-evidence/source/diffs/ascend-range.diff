-    auto mode = static_cast<SparseMode>(sparseMode_);
-    if (mode == SparseMode::RIGHT_DOWN_CAUSAL) {
-        attentionMode_ = 1;
-        preToken_ = INT64_MAX;
-    } else if (mode == SparseMode::DEFAULT_MASK) {
-        attentionMode_ = 0;
