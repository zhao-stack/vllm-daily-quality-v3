+def _build_fingerprint(
+    identity_module,
+    model_config,
+    *,
+    tp_size=1,
+    kv_role=None,
+    max_num_batched_tokens=4096,
+    **vllm_config_kwargs,
+):
+    return identity_module.build_compatibility_fingerprint(
+        _vllm_config(
+            tp_size,
+            kv_role=kv_role,
+            max_num_batched_tokens=max_num_batched_tokens,
+            **vllm_config_kwargs,
+        ),
+        model_config,
+        model_url="model",
+        model_deploy_strategy_name="strategy",
+    )
+
